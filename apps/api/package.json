{
  "name": "@peeer/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test dist/app.controller.spec.js",
    "test:watch": "npm run build && concurrently --kill-others-on-fail --names typescript,test \"tsc --watch --preserveWatchOutput\" \"node --test --watch dist/app.controller.spec.js\""
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "helmet": "^8.3.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.16.0",
    "prisma": "7.10.1",
    "typescript": "^6.0.2"
  }
}
